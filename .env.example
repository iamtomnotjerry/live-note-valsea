# Supabase — Project Settings → API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# VALSEA — RTT local proxy (scripts/valsea-rt-proxy.mjs) reads VALSEA_API_KEY
VALSEA_API_KEY=vl_your_key_here
VALSEA_RT_PROXY_PORT=3331
# Browser connects here (default matches proxy port)
NEXT_PUBLIC_VALSEA_RT_PROXY_URL=ws://127.0.0.1:3331

# Optional later (server-only; never NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=
